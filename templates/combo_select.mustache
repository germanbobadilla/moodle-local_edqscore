{{!
    @template local_edqscore/combo_select

    A "rich" dropdown: a trigger button showing the current selection, which
    opens a panel listing every option with its own description and a
    checkmark for the selected one — backed by a plain <select> so the value
    still posts like any other form field. See amd/src/combo.js.

    Context variables required for this template:
    * name - form field name, also used as the element id
    * currentlabel - label of the currently selected option
    * options - list of {value, label, desc, selected}
}}
<div class="mygama-combo" data-field="{{name}}">
    <button type="button" class="mygama-combo-trigger" aria-haspopup="listbox" aria-expanded="false">
        <span class="mygama-combo-triggerlabel">{{currentlabel}}</span>
        <i class="icon fa fa-chevron-down fa-xs" aria-hidden="true"></i>
    </button>
    <div class="mygama-combo-panel" role="listbox" hidden>
        {{#options}}
        <div class="mygama-combo-option {{#selected}}mygama-combo-option-selected{{/selected}}"
             role="option" data-value="{{value}}" aria-selected="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}" tabindex="-1">
            <span class="mygama-combo-check"><i class="icon fa fa-check fa-xs" aria-hidden="true"></i></span>
            <span class="mygama-combo-optiontext">
                <span class="mygama-combo-optionlabel">{{label}}</span>
                {{#desc}}<span class="mygama-combo-optiondesc">{{desc}}</span>{{/desc}}
            </span>
        </div>
        {{/options}}
    </div>
    <select name="{{name}}" id="{{name}}" class="mygama-combo-native" tabindex="-1" aria-hidden="true">
        {{#options}}
        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
        {{/options}}
    </select>
</div>
