{{!
    @template local_edqscore/assignments_page

    Assignments detail page: one expandable card per assignment, each with a
    per-student detail table.

    Example context (json):
    {
        "backurl": "https://moodle.example.com/local/edqscore/course.php?id=2",
        "pluginname": "EdQ Score",
        "toolbar": {
            "scopelabel": "All students",
            "studentcount": 24,
            "studentslabel": "students",
            "pageurl": "https://moodle.example.com/local/edqscore/course.php",
            "courseid": 2,
            "hasgroups": true,
            "allgroupsselected": false,
            "allgroupslabel": "All groups",
            "selectgrouplabel": "Filter by group",
            "golabel": "Go",
            "groups": [
                {
                    "id": 5,
                    "name": "Group A",
                    "selected": true
                }
            ],
            "cansettings": true,
            "settingsurl": "https://moodle.example.com/local/edqscore/coursesettings.php?id=2",
            "coursesettingslabel": "Course settings"
        },
        "scopenone": false,
        "scopenonemessage": "",
        "hasassignments": true,
        "noactivitiesmessage": "",
        "assignments": [
            {
                "sectiontitle": "Week 1",
                "sectioncount": 1,
                "name": "Essay 1",
                "url": "https://moodle.example.com/mod/assign/view.php?id=7",
                "duedate": "1 Nov 2026",
                "duelabel": "Due",
                "collapseid": "edq-assign-7",
                "gradedpct": 50,
                "gradedlabel": "Graded",
                "submittedcount": 2,
                "totalstudents": 24,
                "submittedlabel": "submitted",
                "hasoverdue": true,
                "overduecount": 1,
                "overduechiplabel": "overdue",
                "allcaughtuplabel": "All caught up",
                "colstudent": "Student",
                "colsubmissiondate": "Submitted",
                "colgradedon": "Graded on",
                "colgrade": "Grade",
                "coloverdue": "Status",
                "colfeedback": "Feedback",
                "noneinscope": false,
                "noneinscopemessage": "",
                "nosubmittedwork": false,
                "nosubmittedworkmessage": "",
                "students": [
                    {
                        "studentname": "Ana Perez",
                        "gradeurl": "https://moodle.example.com/mod/assign/view.php?id=7&action=grader",
                        "submissiondate": "30 Oct 2026",
                        "gradedon": "2 Nov 2026",
                        "grade": "85",
                        "status": {
                            "label": "On time",
                            "pillclass": "mygama-pill-good"
                        },
                        "hasfeedback": true,
                        "feedbackid": "edq-feedback-7-1",
                        "feedbackshowlabel": "Show",
                        "feedbacknolabel": "None",
                        "feedbacktext": "<p>Good work.</p>"
                    }
                ]
            }
        ]
    }
}}
<div class="mygama-course-board">
    <p><a href="{{backurl}}">&laquo; {{pluginname}}</a></p>

    {{#toolbar}}{{> local_edqscore/toolbar }}{{/toolbar}}

    {{#scopenone}}
    <div class="alert alert-warning">{{scopenonemessage}}</div>
    {{/scopenone}}

    <h2 class="mygama-section-title">
        <i class="icon fa fa-clipboard-list fa-fw" aria-hidden="true"></i>
        {{sectiontitle}}
        <span class="mygama-section-count">({{sectioncount}})</span>
    </h2>

    {{^hasassignments}}
    <div class="mygama-empty">
        <i class="icon fa fa-info-circle fa-fw" aria-hidden="true"></i>
        {{noactivitiesmessage}}
    </div>
    {{/hasassignments}}

    {{#assignments}}
    <div class="card mygama-item-card mb-2">
        <div class="mygama-card-header">
            <button type="button" class="mygama-card-toggle" data-bs-toggle="collapse"
                    data-bs-target="#{{collapseid}}" aria-expanded="false" aria-controls="{{collapseid}}"
                    aria-labelledby="{{collapseid}}-title"></button>
            <div class="mygama-card-main">
                <span class="mygama-chevron"><i class="icon fa fa-chevron-right fa-fw" aria-hidden="true"></i></span>
                <div>
                    <div class="mygama-card-title" id="{{collapseid}}-title">
                        {{#url}}
                        <a class="mygama-link" href="{{url}}">
                            <i class="icon fa fa-arrow-up-right-from-square fa-xs" aria-hidden="true"></i> {{{name}}}
                        </a>
                        {{/url}}
                        {{^url}}{{{name}}}{{/url}}
                    </div>
                    <div class="mygama-card-sub">
                        {{duelabel}}: {{#duedate}}{{duedate}}{{/duedate}}{{^duedate}}&mdash;{{/duedate}}
                    </div>
                </div>
            </div>
            <div class="mygama-card-badges">
                <div class="mygama-ring-wrap">
                    <div class="mygama-ring" style="background: conic-gradient(var(--edq-accent-assign) {{gradedpct}}%, var(--edq-border) 0)">
                        <div class="mygama-ring-hole"><span class="mygama-ring-value">{{gradedpct}}%</span></div>
                    </div>
                    <div class="mygama-ring-caption">{{gradedlabel}}</div>
                </div>
                <div class="mygama-chipstack">
                    <span class="mygama-chip mygama-chip-neutral">
                        <i class="icon fa fa-paper-plane" aria-hidden="true"></i> {{submittedlabel}} {{submittedcount}}/{{totalstudents}}
                    </span>
                    {{#hasoverdue}}
                    <span class="mygama-chip mygama-chip-bad">
                        <i class="icon fa fa-fire" aria-hidden="true"></i> {{overduecount}} {{overduechiplabel}}
                    </span>
                    {{/hasoverdue}}
                    {{^hasoverdue}}
                    <span class="mygama-chip mygama-chip-good">
                        <i class="icon fa fa-check" aria-hidden="true"></i> {{allcaughtuplabel}}
                    </span>
                    {{/hasoverdue}}
                </div>
            </div>
        </div>
        <div class="collapse" id="{{collapseid}}">
            <div class="mygama-card-detail table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{colstudent}}</th>
                            <th>{{colsubmissiondate}}</th>
                            <th>{{colgradedon}}</th>
                            <th>{{colgrade}}</th>
                            <th>{{coloverdue}}</th>
                            <th>{{colfeedback}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#noneinscope}}<tr><td colspan="6" class="text-muted">{{noneinscopemessage}}</td></tr>{{/noneinscope}}
                        {{#nosubmittedwork}}<tr><td colspan="6" class="text-muted">{{nosubmittedworkmessage}}</td></tr>{{/nosubmittedwork}}
                        {{#students}}
                        <tr>
                            <td>
                                {{#gradeurl}}<a class="mygama-link" href="{{gradeurl}}">{{studentname}}</a>{{/gradeurl}}
                                {{^gradeurl}}{{studentname}}{{/gradeurl}}
                            </td>
                            <td>{{#submissiondate}}{{submissiondate}}{{/submissiondate}}{{^submissiondate}}&mdash;{{/submissiondate}}</td>
                            <td>{{#gradedon}}{{gradedon}}{{/gradedon}}{{^gradedon}}&mdash;{{/gradedon}}</td>
                            <td>{{#grade}}{{grade}}{{/grade}}{{^grade}}&mdash;{{/grade}}</td>
                            <td><span class="mygama-pill {{status.pillclass}}">{{status.label}}</span></td>
                            <td>
                                {{#hasfeedback}}
                                <button type="button" class="mygama-pill mygama-pill-neutral mygama-feedback-toggle"
                                    data-bs-toggle="collapse" data-bs-target="#{{feedbackid}}"
                                    aria-expanded="false" aria-controls="{{feedbackid}}">
                                    {{feedbackshowlabel}}
                                    <i class="icon fa fa-chevron-down fa-xs mygama-inline-chevron" aria-hidden="true"></i>
                                </button>
                                <div class="collapse" id="{{feedbackid}}">
                                    <div class="mygama-feedback-box">{{{feedbacktext}}}</div>
                                </div>
                                {{/hasfeedback}}
                                {{^hasfeedback}}<span class="text-muted">{{feedbacknolabel}}</span>{{/hasfeedback}}
                            </td>
                        </tr>
                        {{/students}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/assignments}}
</div>
