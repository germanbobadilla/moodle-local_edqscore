{{!
    @template local_edqscore/forums_page

    Forums detail page: one expandable card per forum, each with a
    per-discussion detail table.
}}
<div class="mygama-course-board">
    <p><a href="{{backurl}}">&laquo; {{pluginname}}</a></p>

    {{> local_edqscore/toolbar }}

    {{#scopenone}}
    <div class="alert alert-warning">{{scopenonemessage}}</div>
    {{/scopenone}}

    <h2 class="mygama-section-title">
        <i class="icon fa fa-comments fa-fw" aria-hidden="true"></i>
        {{sectiontitle}}
        <span class="mygama-section-count">({{sectioncount}})</span>
    </h2>

    {{^hasforums}}
    <div class="mygama-empty">
        <i class="icon fa fa-info-circle fa-fw" aria-hidden="true"></i>
        {{noactivitiesmessage}}
    </div>
    {{/hasforums}}

    {{#forums}}
    <div class="card mygama-item-card mb-2">
        <div class="mygama-card-header" role="button" tabindex="0" data-bs-toggle="collapse"
             data-bs-target="#{{collapseid}}" aria-expanded="false" aria-controls="{{collapseid}}">
            <div class="mygama-card-main">
                <span class="mygama-chevron"><i class="icon fa fa-chevron-right fa-fw" aria-hidden="true"></i></span>
                <div>
                    <div class="mygama-card-title">
                        {{#url}}
                        <a class="mygama-link" href="{{url}}" onclick="event.stopPropagation()">
                            <i class="icon fa fa-arrow-up-right-from-square fa-xs" aria-hidden="true"></i> {{name}}
                        </a>
                        {{/url}}
                        {{^url}}{{name}}{{/url}}
                    </div>
                    <div class="mygama-card-sub">
                        {{discussionslabel}}: {{discussioncount}} &middot; {{postslabel}}: {{postcount}}
                    </div>
                </div>
            </div>
            <div class="mygama-card-badges">
                <div class="mygama-ring-wrap">
                    <div class="mygama-ring" style="background: conic-gradient(#158FD1 {{participationpct}}%, #e9ecef 0)">
                        <div class="mygama-ring-hole"><span class="mygama-ring-value">{{participationpct}}%</span></div>
                    </div>
                    <div class="mygama-ring-caption">{{participationlabel}}</div>
                </div>
                <div class="mygama-chipstack">
                    <span class="mygama-chip mygama-chip-neutral">
                        <i class="icon fa fa-comment" aria-hidden="true"></i> {{instructorreplieslabel}} {{instructorreplies}}
                    </span>
                    {{#hasoverdue}}
                    <span class="mygama-chip mygama-chip-bad">
                        <i class="icon fa fa-fire" aria-hidden="true"></i> {{overduecount}} {{overduechiplabel}}
                    </span>
                    {{/hasoverdue}}
                    {{^hasoverdue}}
                    <span class="mygama-chip mygama-chip-good">
                        <i class="icon fa fa-check" aria-hidden="true"></i> {{allcaughtuplabel}}
                    </span>
                    {{/hasoverdue}}
                </div>
            </div>
        </div>
        <div class="collapse" id="{{collapseid}}">
            <div class="mygama-card-detail table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{coldiscussionname}}</th>
                            <th>{{collastpost}}</th>
                            <th>{{colwhen}}</th>
                            <th>{{coloverdue}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#nodiscussions}}<tr><td colspan="4" class="text-muted">{{nodiscussionsmessage}}</td></tr>{{/nodiscussions}}
                        {{#discussions}}
                        <tr>
                            <td><a class="mygama-link" href="{{discussurl}}">{{name}}</a></td>
                            <td>
                                {{#nopost}}<span class="text-muted">{{nopostslabel}}</span>{{/nopost}}
                                {{#bystudent}}<a class="mygama-link" href="{{postanchor}}">{{lastpostname}}</a> ({{studentslabel}}){{/bystudent}}
                                {{#byinstructor}}<a class="mygama-link" href="{{postanchor}}">{{instructorlabel}}</a>{{/byinstructor}}
                            </td>
                            <td>{{#lastposttime}}{{lastposttime}}{{/lastposttime}}{{^lastposttime}}&mdash;{{/lastposttime}}</td>
                            <td><span class="mygama-pill {{status.pillclass}}">{{status.label}}</span></td>
                        </tr>
                        {{/discussions}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/forums}}
</div>
