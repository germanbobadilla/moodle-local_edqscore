{{!
    @template local_edqscore/forums_page

    Forums detail page: one expandable card per forum, each with a
    per-discussion detail table.

    Example context (json):
    {
        "backurl": "https://moodle.example.com/local/edqscore/course.php?id=2",
        "pluginname": "EdQ Score",
        "toolbar": {
            "scopelabel": "All students",
            "studentcount": 24,
            "studentslabel": "students",
            "pageurl": "https://moodle.example.com/local/edqscore/course.php",
            "courseid": 2,
            "hasgroups": true,
            "allgroupsselected": false,
            "allgroupslabel": "All groups",
            "selectgrouplabel": "Filter by group",
            "golabel": "Go",
            "groups": [
                {
                    "id": 5,
                    "name": "Group A",
                    "selected": true
                }
            ],
            "cansettings": true,
            "settingsurl": "https://moodle.example.com/local/edqscore/coursesettings.php?id=2",
            "coursesettingslabel": "Course settings"
        },
        "scopenone": false,
        "scopenonemessage": "",
        "hasforums": true,
        "noactivitiesmessage": "",
        "forums": [
            {
                "sectiontitle": "Week 1",
                "sectioncount": 1,
                "name": "Introductions",
                "url": "https://moodle.example.com/mod/forum/view.php?id=8",
                "collapseid": "edq-forum-8",
                "participationpct": 75,
                "participationlabel": "Participation",
                "discussioncount": 1,
                "discussionslabel": "discussions",
                "postcount": 3,
                "postslabel": "posts",
                "instructorreplies": 1,
                "instructorreplieslabel": "instructor replies",
                "hasoverdue": false,
                "overduecount": 0,
                "overduechiplabel": "overdue",
                "allcaughtuplabel": "All caught up",
                "coldiscussionname": "Discussion",
                "collastpost": "Last post",
                "colwhen": "When",
                "coloverdue": "Status",
                "nodiscussions": false,
                "nodiscussionsmessage": "",
                "discussions": [
                    {
                        "name": "Say hello",
                        "discussurl": "https://moodle.example.com/mod/forum/discuss.php?d=3",
                        "postanchor": "https://moodle.example.com/mod/forum/discuss.php?d=3#p9",
                        "bystudent": true,
                        "byinstructor": false,
                        "nopost": false,
                        "nopostslabel": "No posts",
                        "lastpostname": "Ana Perez",
                        "studentslabel": "student",
                        "instructorlabel": "Instructor",
                        "lastposttime": "3 Nov 2026",
                        "status": {
                            "label": "On time",
                            "pillclass": "mygama-pill-good"
                        }
                    }
                ]
            }
        ]
    }
}}
<div class="mygama-course-board">
    <p><a href="{{backurl}}">&laquo; {{pluginname}}</a></p>

    {{#toolbar}}{{> local_edqscore/toolbar }}{{/toolbar}}

    {{#scopenone}}
    <div class="alert alert-warning">{{scopenonemessage}}</div>
    {{/scopenone}}

    <h2 class="mygama-section-title">
        <i class="icon fa fa-comments fa-fw" aria-hidden="true"></i>
        {{sectiontitle}}
        <span class="mygama-section-count">({{sectioncount}})</span>
    </h2>

    {{^hasforums}}
    <div class="mygama-empty">
        <i class="icon fa fa-info-circle fa-fw" aria-hidden="true"></i>
        {{noactivitiesmessage}}
    </div>
    {{/hasforums}}

    {{#forums}}
    <div class="card mygama-item-card mb-2">
        <div class="mygama-card-header">
            <button type="button" class="mygama-card-toggle" data-bs-toggle="collapse"
                    data-bs-target="#{{collapseid}}" aria-expanded="false" aria-controls="{{collapseid}}"
                    aria-labelledby="{{collapseid}}-title"></button>
            <div class="mygama-card-main">
                <span class="mygama-chevron"><i class="icon fa fa-chevron-right fa-fw" aria-hidden="true"></i></span>
                <div>
                    <div class="mygama-card-title" id="{{collapseid}}-title">
                        {{#url}}
                        <a class="mygama-link" href="{{url}}">
                            <i class="icon fa fa-arrow-up-right-from-square fa-xs" aria-hidden="true"></i> {{{name}}}
                        </a>
                        {{/url}}
                        {{^url}}{{{name}}}{{/url}}
                    </div>
                    <div class="mygama-card-sub">
                        {{discussionslabel}}: {{discussioncount}} &middot; {{postslabel}}: {{postcount}}
                    </div>
                </div>
            </div>
            <div class="mygama-card-badges">
                <div class="mygama-ring-wrap">
                    <div class="mygama-ring" style="background: conic-gradient(var(--edq-accent-forum) {{participationpct}}%, var(--edq-border) 0)">
                        <div class="mygama-ring-hole"><span class="mygama-ring-value">{{participationpct}}%</span></div>
                    </div>
                    <div class="mygama-ring-caption">{{participationlabel}}</div>
                </div>
                <div class="mygama-chipstack">
                    <span class="mygama-chip mygama-chip-neutral">
                        <i class="icon fa fa-comment" aria-hidden="true"></i> {{instructorreplieslabel}} {{instructorreplies}}
                    </span>
                    {{#hasoverdue}}
                    <span class="mygama-chip mygama-chip-bad">
                        <i class="icon fa fa-fire" aria-hidden="true"></i> {{overduecount}} {{overduechiplabel}}
                    </span>
                    {{/hasoverdue}}
                    {{^hasoverdue}}
                    <span class="mygama-chip mygama-chip-good">
                        <i class="icon fa fa-check" aria-hidden="true"></i> {{allcaughtuplabel}}
                    </span>
                    {{/hasoverdue}}
                </div>
            </div>
        </div>
        <div class="collapse" id="{{collapseid}}">
            <div class="mygama-card-detail table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{coldiscussionname}}</th>
                            <th>{{collastpost}}</th>
                            <th>{{colwhen}}</th>
                            <th>{{coloverdue}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#nodiscussions}}<tr><td colspan="4" class="text-muted">{{nodiscussionsmessage}}</td></tr>{{/nodiscussions}}
                        {{#discussions}}
                        <tr>
                            <td><a class="mygama-link" href="{{discussurl}}">{{{name}}}</a></td>
                            <td>
                                {{#nopost}}<span class="text-muted">{{nopostslabel}}</span>{{/nopost}}
                                {{#bystudent}}<a class="mygama-link" href="{{postanchor}}">{{lastpostname}}</a> ({{studentslabel}}){{/bystudent}}
                                {{#byinstructor}}<a class="mygama-link" href="{{postanchor}}">{{instructorlabel}}</a>{{/byinstructor}}
                            </td>
                            <td>{{#lastposttime}}{{lastposttime}}{{/lastposttime}}{{^lastposttime}}&mdash;{{/lastposttime}}</td>
                            <td><span class="mygama-pill {{status.pillclass}}">{{status.label}}</span></td>
                        </tr>
                        {{/discussions}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/forums}}
</div>
