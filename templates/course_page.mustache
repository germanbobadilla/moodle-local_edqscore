{{!
    @template local_edqscore/course_page

    The per-course EdQ Score dashboard: teacher EdQ score, a completion-rate
    chart, and three clickable cards leading to the Assignments, Forums and
    Quizzes detail pages.

    Example context (json):
    {
        "courseurl": "https://moodle.example.com/course/view.php?id=2",
        "coursefullname": "English B2",
        "username": "Alex Rivera",
        "toolbar": {
            "scopelabel": "All students",
            "studentcount": 24,
            "studentslabel": "students",
            "pageurl": "https://moodle.example.com/local/edqscore/course.php",
            "courseid": 2,
            "hasgroups": true,
            "allgroupsselected": false,
            "allgroupslabel": "All groups",
            "selectgrouplabel": "Filter by group",
            "golabel": "Go",
            "groups": [
                {
                    "id": 5,
                    "name": "Group A",
                    "selected": true
                }
            ],
            "cansettings": true,
            "settingsurl": "https://moodle.example.com/local/edqscore/coursesettings.php?id=2",
            "coursesettingslabel": "Course settings"
        },
        "scopenone": false,
        "scopenonemessage": "",
        "hasedqdata": true,
        "edqlabel": "EdQ Score",
        "edqscore": 82,
        "edqcolor": "var(--edq-hero-warn)",
        "edqnodatalabel": "No data yet",
        "hasedqmisses": true,
        "edqmissescount": 1,
        "edqmisseslabel": "items affecting your score",
        "edqmissesurl": "https://moodle.example.com/local/edqscore/edqmisses.php?id=2",
        "totalactivities": 3,
        "activitieslabel": "activities",
        "studentcount": 24,
        "studentslabel": "students",
        "hasoverdue": true,
        "totaloverdue": 1,
        "overduelabel": "overdue",
        "overduechiplabel": "overdue",
        "haschart": true,
        "charttitle": "Completion",
        "completionbars": [
            {
                "label": "Assignments",
                "pct": 50,
                "accent": "var(--edq-accent-assign)"
            }
        ],
        "assignurl": "https://moodle.example.com/local/edqscore/assignments.php?id=2",
        "assigntitle": "Assignments",
        "assigncount": 1,
        "assigngradedavg": 50,
        "gradedlabel": "Graded",
        "hasassignoverdue": true,
        "assignoverdue": 1,
        "forumurl": "https://moodle.example.com/local/edqscore/forums.php?id=2",
        "forumtitle": "Forums",
        "forumcount": 1,
        "forumparticipationavg": 75,
        "participationlabel": "Participation",
        "hasforumoverdue": false,
        "forumoverdue": 0,
        "quizurl": "https://moodle.example.com/local/edqscore/quizzes.php?id=2",
        "quiztitle": "Quizzes",
        "quizcount": 1,
        "quizgradedavg": 50,
        "hasquizoverdue": false,
        "quizoverdue": 0,
        "viewdetailslabel": "View details"
    }
}}
<div class="mygama-course-board">
    <p><a href="{{courseurl}}">&laquo; {{{coursefullname}}}</a></p>

    <div class="mygama-edq-card">
        <div class="mygama-edq-profile">
            {{{userpicture}}}
            <div>
                <div class="mygama-edq-name">{{username}}</div>
                <div class="mygama-edq-context">{{{coursefullname}}}</div>
            </div>
        </div>
        <div class="mygama-edq-score">
            <div class="mygama-edq-full">
                <div class="mygama-edq-labelrow">{{edqlabel}} {{{edqhelpicon}}}</div>
                <a class="mygama-edq-misseslink" href="{{edqmissesurl}}">
                    {{edqmisseslabel}}
                    {{#hasedqmisses}}<span class="mygama-section-count">({{edqmissescount}})</span>{{/hasedqmisses}}
                    <i class="icon fa fa-arrow-right fa-xs" aria-hidden="true"></i>
                </a>
            </div>
            {{#hasedqdata}}
            <div class="mygama-edq-ring" style="background: conic-gradient({{edqcolor}} {{edqscore}}%, var(--edq-hero-ring-track) 0)">
                <div class="mygama-edq-ring-hole">
                    <span class="mygama-edq-value">{{edqscore}}%</span>
                    <span class="mygama-edq-caption">{{edqlabel}}</span>
                </div>
            </div>
            {{/hasedqdata}}
            {{^hasedqdata}}
            <div class="mygama-edq-ring mygama-edq-ring-empty">
                <div class="mygama-edq-ring-hole">
                    <span class="mygama-edq-value mygama-edq-value-empty">&ndash;</span>
                    <span class="mygama-edq-caption">{{edqnodatalabel}}</span>
                </div>
            </div>
            {{/hasedqdata}}
        </div>
    </div>

    {{#toolbar}}{{> local_edqscore/toolbar }}{{/toolbar}}

    {{#scopenone}}
    <div class="alert alert-warning">{{scopenonemessage}}</div>
    {{/scopenone}}

    {{^scopenone}}
    <div class="mygama-kpirow">
        <div class="mygama-kpi">
            <div class="mygama-kpi-value">{{studentcount}}</div>
            <div class="mygama-kpi-label">{{studentslabel}}</div>
        </div>
        <div class="mygama-kpi">
            <div class="mygama-kpi-value">{{totalactivities}}</div>
            <div class="mygama-kpi-label">{{activitieslabel}}</div>
        </div>
        <div class="mygama-kpi">
            <div class="mygama-kpi-value {{#hasoverdue}}mygama-kpi-danger{{/hasoverdue}}">{{totaloverdue}}</div>
            <div class="mygama-kpi-label">{{overduelabel}}</div>
        </div>
    </div>

    {{#haschart}}
    <div class="mygama-chartcard">
        <h2>{{charttitle}}</h2>
        {{#completionbars}}
        <div class="mygama-minibar-row">
            <span class="mygama-minibar-label">{{label}}</span>
            <div class="mygama-minibar-track">
                <div class="mygama-minibar-fill" style="width: {{pct}}%; background: {{accent}};"></div>
            </div>
            <span class="mygama-minibar-value">{{pct}}%</span>
        </div>
        {{/completionbars}}
    </div>
    {{/haschart}}

    <div class="mygama-summarygrid">
        <a class="mygama-summarycard" style="--mygama-accent: var(--edq-accent-assign);" href="{{assignurl}}">
            <div class="mygama-summarycard-icon"><i class="icon fa fa-clipboard-list fa-fw" aria-hidden="true"></i></div>
            <div class="mygama-summarycard-title">{{assigntitle}}</div>
            <div class="mygama-summarycard-statvalue">{{assigngradedavg}}%</div>
            <div class="mygama-summarycard-statlabel">{{assigncount}} &middot; {{gradedlabel}}</div>
            {{#hasassignoverdue}}
            <span class="mygama-chip mygama-chip-bad" style="align-self: flex-start;">
                <i class="icon fa fa-fire" aria-hidden="true"></i> {{assignoverdue}} {{overduechiplabel}}
            </span>
            {{/hasassignoverdue}}
            <span class="mygama-summarycard-cta">{{viewdetailslabel}} &rarr;</span>
        </a>
        <a class="mygama-summarycard" style="--mygama-accent: var(--edq-accent-forum);" href="{{forumurl}}">
            <div class="mygama-summarycard-icon"><i class="icon fa fa-comments fa-fw" aria-hidden="true"></i></div>
            <div class="mygama-summarycard-title">{{forumtitle}}</div>
            <div class="mygama-summarycard-statvalue">{{forumparticipationavg}}%</div>
            <div class="mygama-summarycard-statlabel">{{forumcount}} &middot; {{participationlabel}}</div>
            {{#hasforumoverdue}}
            <span class="mygama-chip mygama-chip-bad" style="align-self: flex-start;">
                <i class="icon fa fa-fire" aria-hidden="true"></i> {{forumoverdue}} {{overduechiplabel}}
            </span>
            {{/hasforumoverdue}}
            <span class="mygama-summarycard-cta">{{viewdetailslabel}} &rarr;</span>
        </a>
        <a class="mygama-summarycard" style="--mygama-accent: var(--edq-accent-quiz);" href="{{quizurl}}">
            <div class="mygama-summarycard-icon"><i class="icon fa fa-circle-question fa-fw" aria-hidden="true"></i></div>
            <div class="mygama-summarycard-title">{{quiztitle}}</div>
            <div class="mygama-summarycard-statvalue">{{quizgradedavg}}%</div>
            <div class="mygama-summarycard-statlabel">{{quizcount}} &middot; {{gradedlabel}}</div>
            {{#hasquizoverdue}}
            <span class="mygama-chip mygama-chip-bad" style="align-self: flex-start;">
                <i class="icon fa fa-fire" aria-hidden="true"></i> {{quizoverdue}} {{overduechiplabel}}
            </span>
            {{/hasquizoverdue}}
            <span class="mygama-summarycard-cta">{{viewdetailslabel}} &rarr;</span>
        </a>
    </div>
    {{/scopenone}}
</div>
